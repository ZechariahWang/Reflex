<?xml version="1.0"?>
<robot name="htn_hand" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- The hand as built: CAD meshes, and per finger the real linkage
       (servo horn -> pushrod -> triangle -> bars -> adapter + contact pad).

       URDF is a tree, the linkage has loops. So every part hangs on ONE of its
       pivots, <finger>_joint (the servo horn) is the only driven joint, and the
       other six joints of a finger are passive: htn_control's linkage_publisher
       computes them from the horn angle, which closes the loops again.
       Pivots come from config/linkage.yaml (generated from the CAD by
       tools/cad_to_linkage.py); limits, masses and colours from hand_params.yaml.

       base_link is the CAD assembly frame, in metres: fingers point along +Y,
       they curl towards -Z (the palm side), the thumb is on the +X side. -->

  <xacro:arg name="params_file" default="$(find htn_description)/config/hand_params.yaml"/>
  <xacro:arg name="linkage_file" default="$(find htn_description)/config/linkage.yaml"/>
  <!-- none: plain URDF (visualization) | gazebo: adds world mount + ros2_control -->
  <xacro:arg name="sim" default="none"/>
  <!-- controller_manager yaml, needed for sim:=gazebo -->
  <xacro:arg name="controllers_file" default=""/>
  <!-- full: every part | horns: base + servo horns only. Gazebo gets `horns`:
       it cannot close the loops, and free passive links would just dangle. -->
  <xacro:arg name="parts" default="full"/>

  <xacro:property name="params" value="${xacro.load_yaml('$(arg params_file)')}"/>
  <xacro:property name="linkage" value="${xacro.load_yaml('$(arg linkage_file)')['fingers']}"/>
  <xacro:property name="joint_params" value="${params['joint']}"/>
  <xacro:property name="full" value="${'$(arg parts)' == 'full'}"/>
  <xacro:property name="MESHES" value="package://htn_description/meshes"/>

  <!-- Gazebo (DART) stops obeying velocity commands once a joint rests exactly
       on its limit, so in sim the hard stops sit slightly outside the commanded
       range [min_angle, max_angle] and the servos never touch them. -->
  <xacro:property name="limit_margin" value="${0.05 if '$(arg sim)' == 'gazebo' else 0.0}"/>

  <!-- A pivot of finger `l` (linkage.yaml entry) as "x y z" in metres, relative to
       pivot `origin` (None = the base frame). Pivots are 2-D in the linkage plane. -->
  <xacro:property name="at" value="${lambda l, name, origin=None: ' '.join(str(v / 1000.0) for v in (
      lambda p, o, c: ((c, p[0] - o[0], p[1] - o[1]) if l['axis'] == 'x' else (p[0] - o[0], p[1] - o[1], c)))(
      l['pivots'][name], l['pivots'][origin] if origin else (0.0, 0.0), 0.0 if origin else l['plane']))}"/>
  <xacro:property name="axis_of" value="${lambda l, sign=1: '%g 0 0' % sign if l['axis'] == 'x' else '0 0 %g' % sign}"/>

  <xacro:property name="look" value="${params['appearance']}"/>
  <xacro:macro name="colour" params="name">
    <material name="${name}"><color rgba="${' '.join(str(v) for v in look[name])} 1"/></material>
  </xacro:macro>
  <xacro:colour name="body"/>
  <xacro:colour name="servo"/>
  <xacro:colour name="finger"/>
  <xacro:colour name="accent"/>
  <xacro:colour name="pad"/>
  <xacro:colour name="wearer"/>

  <!-- A CAD mesh (mm, assembly frame) on a link whose frame sits at `pivot`. The
       physics-only model gets a marker cube instead: Gazebo does not resolve
       package:// paths by itself, and nobody looks at that model. -->
  <xacro:macro name="part" params="mesh material pivot:='0 0 0'">
    <visual>
      <xacro:if value="${full}">
        <origin xyz="${' '.join(str(-float(v)) for v in pivot.split())}"/>
        <geometry><mesh filename="${MESHES}/${mesh}.stl" scale="0.001 0.001 0.001"/></geometry>
      </xacro:if>
      <xacro:unless value="${full}">
        <geometry><box size="0.01 0.01 0.01"/></geometry>
      </xacro:unless>
      <material name="${material}"/>
    </visual>
  </xacro:macro>

  <!-- Gazebo needs an inertia on every moving link; a small solid cube will do -->
  <xacro:macro name="cube_inertial" params="m side">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*side*side/6}" iyy="${m*side*side/6}" izz="${m*side*side/6}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <link name="base_link">
    <xacro:part mesh="base" material="body"/>
    <xacro:if value="${full}">
      <!-- the mannequin hand of the CAD, open: a reference for scale, it does not move -->
      <xacro:part mesh="wearer" material="wearer"/>
    </xacro:if>
    <xacro:cube_inertial m="${params['base']['mass']}" side="0.10"/>
  </link>

  <!-- A passive link on its parent's pivot -->
  <xacro:macro name="passive" params="finger role l parent pivot origin material">
    <link name="${finger}_${role}">
      <xacro:part mesh="${finger}_${role}" material="${material}" pivot="${at(l, pivot)}"/>
    </link>
    <joint name="${finger}_${role}_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${finger}_${role}"/>
      <origin xyz="${at(l, pivot, origin)}"/>
      <axis xyz="${axis_of(l)}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="finger" params="name">
    <xacro:property name="f" value="${params['fingers'][name]}"/>
    <xacro:property name="l" value="${linkage[name]}"/>

    <!-- The servo horn: the one driven joint. Its axis is turned so that a
         positive angle closes the finger, whichever way the horn really turns. -->
    <link name="${name}_horn">
      <xacro:part mesh="${name}_horn" material="servo" pivot="${at(l, 'G0')}"/>
      <xacro:cube_inertial m="${f['mass']}" side="0.02"/>
    </link>
    <joint name="${name}_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${name}_horn"/>
      <origin xyz="${at(l, 'G0')}"/>
      <axis xyz="${axis_of(l, l['closing'])}"/>
      <limit lower="${f['min_angle'] - limit_margin}" upper="${f['max_angle'] + limit_margin}"
             effort="${joint_params['max_effort']}" velocity="${joint_params['max_velocity']}"/>
      <dynamics damping="${joint_params['damping']}" friction="${joint_params['friction']}"/>
    </joint>

    <xacro:if value="${full}">
      <xacro:passive finger="${name}" role="rod" l="${l}" parent="${name}_horn" pivot="P" origin="G0" material="finger"/>
      <xacro:passive finger="${name}" role="triangle" l="${l}" parent="base_link" pivot="G1" origin="${None}" material="accent"/>
      <xacro:passive finger="${name}" role="ternary" l="${l}" parent="${name}_triangle" pivot="B" origin="G1" material="finger"/>
      <xacro:passive finger="${name}" role="long" l="${l}" parent="base_link" pivot="G2" origin="${None}" material="finger"/>
      <xacro:passive finger="${name}" role="binary" l="${l}" parent="${name}_long" pivot="T" origin="G2" material="finger"/>

      <!-- <finger>_finger is the part on the wearer's finger: adapter + contact pad -->
      <link name="${name}_finger">
        <xacro:part mesh="${name}_adapter" material="accent" pivot="${at(l, 'E')}"/>
        <xacro:part mesh="${name}_contact" material="pad" pivot="${at(l, 'E')}"/>
      </link>
      <joint name="${name}_adapter_joint" type="continuous">
        <parent link="${name}_ternary"/>
        <child link="${name}_finger"/>
        <origin xyz="${at(l, 'E', 'B')}"/>
        <axis xyz="${axis_of(l)}"/>
      </joint>
    </xacro:if>
  </xacro:macro>

  <xacro:finger name="thumb"/>
  <xacro:finger name="index"/>
  <xacro:finger name="middle"/>
  <xacro:finger name="ring"/>
  <xacro:finger name="pinky"/>

  <xacro:if value="${'$(arg sim)' == 'gazebo'}">
    <xacro:include filename="hand.gazebo.xacro"/>
  </xacro:if>

</robot>
