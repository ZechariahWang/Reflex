# Copy to policy/lambda/.env (ignored by git). This file stays on the laptop: only
# CLAUDE_CODE_OAUTH_TOKEN goes to the instance, in a temporary file.

# https://cloud.lambdalabs.com/api-keys
LAMBDA_API_KEY=
# Name of an ssh key registered in the Lambda account, and its private half here
LAMBDA_SSH_KEY_NAME=
#LAMBDA_SSH_KEY_PATH=~/.ssh/id_ed25519

# One type; the launch polls until it has capacity. No GH200 (ARM).
LAMBDA_INSTANCE_TYPE=gpu_1x_a100_sxm4
#LAMBDA_REGION=us-east-1

# One folder of policy/datasets/
LAMBDA_DATASET=exo_grasp
# The watchdog terminates the instance this long after the launch, whatever runs
LAMBDA_MAX_HOURS=4

# From `claude setup-token`. Revoke it after the hackathon.
CLAUDE_CODE_OAUTH_TOKEN=
