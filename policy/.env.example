# Copy to policy/.env (ignored by git). Settings of policy/run_policy.sh, on the GPU laptop.

# The pretrained_model folder of a checkpoint, absolute or from policy/
POLICY_CHECKPOINT=outputs/train/RUN-<UTC>/default/checkpoints/005000/pretrained_model

# The machine with rosbridge (port 9090)
ROS_HOST=localhost

POLICY_DEVICE=cuda
# The tick rate of the dataset: 30 for the web console, the --dataset.fps for lerobot-record.
# One action of the model is one tick: a lower rate here plays every movement too slowly.
POLICY_FPS=30
# How many actions of a chunk the hand plays before a newer chunk replaces them. Times the tick it
# must be longer than an inference (up to 1.2 s on an RTX 4050): 50 is the whole chunk of SmolVLA
POLICY_ACTIONS_PER_CHUNK=50
#POLICY_PORT=8080
# 1: the hand moves only while the policy switch of the web console is on (it starts off).
# 0: no switch, the policy moves the hand from its first action
POLICY_GATE=1
# Set and empty: no head camera (no phone plugged in), the model sees the wrist camera only.
# A model that was trained with the head camera does worse without it
#POLICY_HEAD_TOPIC=
# "no data from rosbridge within 0.3 s" now and then, on a loaded laptop: allow an older picture
#POLICY_MAX_AGE_S=0.6
